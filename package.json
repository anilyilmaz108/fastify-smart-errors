{
  "name": "fastify-smart-errors",
  "version": "1.0.0",
  "description": "Smart, consistent and i18n-ready error handling for Fastify",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --tsconfig tsconfig.json",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fastify",
    "errors",
    "i18n"
  ],
  "license": "ISC",
  "dependencies": {
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
